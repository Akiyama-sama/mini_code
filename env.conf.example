# 配置模板：复制成本地配置后填写真实值
#
#   cp env.conf.example env.conf
#
# env.conf 已写入 .gitignore，不会被提交 / push；
# 只有本文件 env.conf.example 会进入仓库，请勿在这里填真实 API_KEY。

# ---------- 本地模型（如 Ollama / vLLM 的 OpenAI 兼容接口） ----------
BASE_LOCAL_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b

# ---------- 远程模型 ----------
BASE_REMOTE_URL=https://api.example.com/v1
REMOTE_MODEL=deepseek-v4.1-flash
# 远程模式才需要；留空表示本地模式无需鉴权
API_KEY=

# ---------- 生效模式：REMOTE 或 LOCAL ----------
USAGE=LOCAL
